        "url unshortener api",
        "unshorten url",
        "expand shortened link",
        "url redirect tracker",
        "follow redirects"
    ],
    "homepage": "https://apiverve.com/marketplace/urlunshortener?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
